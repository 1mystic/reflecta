# --- data (keep the catalog + legacy CSVs, ignore large downloads) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# --- experiment tracking / models ---
wandb/
mlruns/
mlartifacts/
*.ckpt
*.pt
# The offline knowledge-tracing artifacts (models_store/) and the MLflow store (mlflow.db)
# are small (~1.8MB total) and committed ON PURPOSE: the Model Lab reads them live in
# production so the deployed app shows real trained-model data instead of "No Models". They
# are re-included below despite the broad *.pt / mlflow.db ignores. (Retraining locally will
# show these as modified - that is expected; commit or discard as you see fit.)
!mlflow.db
!models_store/
!models_store/*

# --- captured user sessions (real response data) ---
data/sessions/
data/pending_sessions/

# local agent/skill tool artifacts (not project source)
.agents/
skills-lock.json
# Claude-generated topic banks (cached per user topic)
data/generated_banks/

# --- secrets / env ---
.env

# --- os ---
.DS_Store
Thumbs.db
