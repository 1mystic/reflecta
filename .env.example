# Copy to `.env` and fill in. `.env` is gitignored, and auto-loaded on startup
# (reflecta.config loads it via python-dotenv before reading any setting below) — no
# need to `export` these into your shell manually. Restart the server after editing.

# --- experiment tracking ---
# Default is local MLflow (writes ./mlruns, no account, fully self-contained).
# Set to "wandb" for cloud tracking, or "none" to disable.
REFLECTA_TRACKER=mlflow

# only needed if REFLECTA_TRACKER=wandb:
WANDB_API_KEY=            # from https://wandb.ai/authorize (free tier)
WANDB_PROJECT=reflecta
WANDB_ENTITY=             # your wandb username/team (optional)

# --- open-topic quiz generation (optional, paid) ---
# With a key set, learners can quiz on ANY topic (social science, history, ...):
# Claude generates a cached diagnostic bank per topic (concepts, difficulties,
# reworded twins, misconception distractors). Without it, the curated bank still works.
ANTHROPIC_API_KEY=
# default is haiku (cheapest); bump to claude-sonnet-5 / claude-opus-4-8 for harder topics
REFLECTA_ANTHROPIC_MODEL=claude-haiku-4-5

# --- reflection engine (free/local) ---
# Path to a local gguf/HF model, or an OpenAI-compatible local endpoint (e.g. Ollama).
REFLECTA_LLM_BACKEND=none          # none | ollama | transformers
REFLECTA_LLM_MODEL=llama3.2:3b
REFLECTA_LLM_BASE_URL=http://localhost:11434/v1
